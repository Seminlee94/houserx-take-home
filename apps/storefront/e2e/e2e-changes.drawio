        </mxCell>
        <mxCell id="b5" value="Parallel adds to one cart never return 500; total equals the adds accepted" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="653" width="460" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="One cart: up to 5 parallel adds fine, at 10 about 1 in 5 get 500; totals stay correct. Separate carts: 250 of 250 passed" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="750" y="653" width="390" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;P3 Remaining routes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="699" width="230" height="46" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="Promotions, shipping options, registered customers, returns, response shape" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="290" y="699" width="460" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Not checked" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="750" y="699" width="390" height="46" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="3. Load testing with k6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="550" height="515" as="geometry" />
        </mxCell>
        <mxCell id="l0" value="&lt;b&gt;What to run&lt;/b&gt;&lt;br/&gt;The cart flow from the API suite: create cart, add, change quantity. Add browsing and checkout once they're covered." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="815" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;Where to run it&lt;/b&gt;&lt;br/&gt;medusa build + start and next build + start with their own DB. Not :9001 or :8001: those are dev servers, so timings mean little." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="893" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;Test types&lt;/b&gt;&lt;br/&gt;Smoke (does the script work), load (expected traffic), stress and spike (find the limit), soak (leaks over hours)." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="971" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;What counts as a pass&lt;/b&gt;&lt;br/&gt;Agreed p95 and error-rate targets, and subtotals still correct under load. Set targets from expected traffic; none exist yet." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1049" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;Settle first&lt;/b&gt;&lt;br/&gt;REDIS_URL is in .env but medusa-config.ts doesn't use it, so Medusa uses in-memory defaults. Decide this before testing multiple instances." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="1127" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="&lt;b&gt;Smoke run so far&lt;/b&gt;&lt;br/&gt;5 users for 15s on the dev server: 90 requests, 0 failed, all subtotals right. The script works; p95 of 2.54s is not a benchmark." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="1205" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="4. Security and penetration testing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="610" y="780" width="550" height="515" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="&lt;b&gt;Every build&lt;/b&gt;&lt;br/&gt;pnpm audit for dependencies and a secret scan. Cheap checks that need no running app." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="815" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Nightly&lt;/b&gt;&lt;br/&gt;ZAP baseline scan via Docker against the production build: headers, CORS and common misconfigurations." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="893" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Penetration test scope&lt;/b&gt;&lt;br/&gt;Cross-customer access, cart ID exposure, checkout and order tampering, login brute force, admin dashboard and API." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="971" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Ground rules&lt;/b&gt;&lt;br/&gt;Staging with production config, written scope and authorization, no real customer data, test payment provider only." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="1049" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Gaps seen&lt;/b&gt;&lt;br/&gt;200 rapid requests all returned 200, and src has no rate-limit code; hosting could add it, none is set up here. X-Powered-By: Express is exposed." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="630" y="1127" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Held up in spot checks (not a pen test)&lt;/b&gt;&lt;br/&gt;Other origins get no CORS allow header; SQL-like cart ID gives 404. A cart ID plus the public key opens a cart, so that ID must not leak." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="630" y="1205" width="510" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
