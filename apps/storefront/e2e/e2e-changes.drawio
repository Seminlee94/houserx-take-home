        <mxCell id="s3" value="3. What an API test looks like" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="570" height="305" as="geometry" />
        </mxCell>
        <mxCell id="ex" value='import&amp;nbsp;{&amp;nbsp;test,&amp;nbsp;expect,&amp;nbsp;BLACK_SKU,&amp;nbsp;EXPECTED_PRICE&amp;nbsp;}&amp;nbsp;from&amp;nbsp;"../fixtures"&lt;br/&gt;&lt;br/&gt;test("quantity&amp;nbsp;change&amp;nbsp;reprices&amp;nbsp;the&amp;nbsp;persisted&amp;nbsp;cart",&lt;br/&gt;&amp;nbsp;&amp;nbsp;async&amp;nbsp;({&amp;nbsp;storeApi,&amp;nbsp;apiCart&amp;nbsp;})&amp;nbsp;=&amp;gt;&amp;nbsp;{&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;const&amp;nbsp;res&amp;nbsp;=&amp;nbsp;await&amp;nbsp;storeApi.updateItem(&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;apiCart.cartId,&amp;nbsp;apiCart.lineId,&amp;nbsp;{&amp;nbsp;quantity:&amp;nbsp;2&amp;nbsp;})&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expect(res.status).toBe(200)&lt;br/&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;const&amp;nbsp;{&amp;nbsp;body&amp;nbsp;}&amp;nbsp;=&amp;nbsp;await&amp;nbsp;storeApi.getCart(apiCart.cartId)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;const&amp;nbsp;[item]&amp;nbsp;=&amp;nbsp;body.cart.items&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expect(item.variant.sku).toBe(BLACK_SKU)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expect(item.quantity).toBe(2)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expect(item.unit_price).toBe(EXPECTED_PRICE)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expect(body.cart.currency_code).toBe("eur")&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expect(body.cart.item_subtotal).toBe(EXPECTED_PRICE&amp;nbsp;*&amp;nbsp;2)&lt;br/&gt;&amp;nbsp;&amp;nbsp;})' style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#666666;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="805" width="530" height="255" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Config change in playwright.config.ts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="570" height="215" as="geometry" />
        </mxCell>
        <mxCell id="cfg" value='projects:&amp;nbsp;[&lt;br/&gt;&amp;nbsp;&amp;nbsp;{&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;name:&amp;nbsp;"ui",&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;testIgnore:&amp;nbsp;"**/api/**",&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;use:&amp;nbsp;{&amp;nbsp;...devices["Desktop&amp;nbsp;Chrome"]&amp;nbsp;},&lt;br/&gt;&amp;nbsp;&amp;nbsp;},&lt;br/&gt;&amp;nbsp;&amp;nbsp;{&amp;nbsp;name:&amp;nbsp;"api",&amp;nbsp;testDir:&amp;nbsp;"./e2e/api"&amp;nbsp;},&lt;br/&gt;],' style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#666666;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1125" width="530" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cfgnote" value="webServer is global: gate the storefront entry so an API-only run needs just the backend." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1265" width="530" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Proposed API suite (e2e/api/)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="630" y="770" width="530" height="535" as="geometry" />
        </mxCell>
        <mxCell id="r1" value='&lt;b&gt;cart-quantity-failures.api.spec.ts&lt;/b&gt; (move existing)&lt;br/&gt;qty -1 and "2" give 400; missing line item rejected; cart stays 1x, EUR 10' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="805" width="490" height="75" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;cart-pricing.api.spec.ts&lt;/b&gt;&lt;br/&gt;add 1x gives EUR 10; qty 2 gives EUR 20; SKU, unit price and currency match" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="890" width="490" height="75" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;store-contract.api.spec.ts&lt;/b&gt;&lt;br/&gt;no publishable key: 400; unknown cart: 404; unknown variant: 400" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="975" width="490" height="75" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;cart-fractional-quantity.api.spec.ts&lt;/b&gt;&lt;br/&gt;qty 1.5 should be 400 but is accepted. Mark test.fail() until the backend adds .int()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="1060" width="490" height="75" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;checkout-order.api.spec.ts&lt;/b&gt;&lt;br/&gt;address, shipping, payment, complete; assert order totals; no duplicate on re-submit (planned in SUBMISSION.md, not probed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#555555;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="1145" width="490" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="&lt;b&gt;UI specs keep&lt;/b&gt; one flow per customer scenario. Math and failure cases move down to this layer." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="1240" width="490" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. What a UI test looks like with page objects" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="1320" width="1120" height="345" as="geometry" />
        </mxCell>
        <mxCell id="ui_ex" value='//&amp;nbsp;cart-pricing.spec.ts&amp;nbsp;(simplified)&lt;br/&gt;test("adds&amp;nbsp;M/Black&amp;nbsp;and&amp;nbsp;reprices",&lt;br/&gt;&amp;nbsp;&amp;nbsp;async&amp;nbsp;({&amp;nbsp;newShopper&amp;nbsp;})&amp;nbsp;=&amp;gt;&amp;nbsp;{&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;const&amp;nbsp;{&amp;nbsp;productPage,&amp;nbsp;cartPage&amp;nbsp;}&amp;nbsp;=&amp;nbsp;await&amp;nbsp;newShopper()&lt;br/&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;await&amp;nbsp;productPage.addShirt("Black")&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;await&amp;nbsp;cartPage.goto()&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;await&amp;nbsp;cartPage.expectSubtotal(10)&lt;br/&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;await&amp;nbsp;cartPage.changeQuantity(2)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;await&amp;nbsp;cartPage.expectSubtotal(20)&lt;br/&gt;&amp;nbsp;&amp;nbsp;})' style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#666666;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1355" width="530" height="245" as="geometry" />
        </mxCell>
        <mxCell id="pom_ex" value='//&amp;nbsp;pages/cart-page.ts&amp;nbsp;(excerpt)&lt;br/&gt;export&amp;nbsp;class&amp;nbsp;CartPage&amp;nbsp;{&lt;br/&gt;&amp;nbsp;&amp;nbsp;async&amp;nbsp;expectSubtotal(amount:&amp;nbsp;number)&amp;nbsp;{&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;await&amp;nbsp;expect(this.subtotal)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;.toHaveAttribute("data-value",&amp;nbsp;String(amount))&lt;br/&gt;&amp;nbsp;&amp;nbsp;}&lt;br/&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;async&amp;nbsp;changeQuantity(quantity:&amp;nbsp;number)&amp;nbsp;{&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;const&amp;nbsp;updated&amp;nbsp;=&amp;nbsp;this.page.waitForResponse(&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(r)&amp;nbsp;=&amp;gt;&amp;nbsp;r.request().method()&amp;nbsp;===&amp;nbsp;"POST"&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;r.url().includes("/dk/cart")&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;r.ok())&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;await&amp;nbsp;this.selectQuantity(quantity)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;await&amp;nbsp;updated&lt;br/&gt;&amp;nbsp;&amp;nbsp;}&lt;br/&gt;}' style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#666666;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="1355" width="530" height="245" as="geometry" />
        </mxCell>
        <mxCell id="pom_note" value="newShopper creates both page objects for each shopper's own page. API tests don't use them: storeApi is their reusable layer. Fault injection stays in pricing-regression.spec.ts because it's specific to that test." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1610" width="1080" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
